{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jason.local/schemas/approvals/decision.schema.json",
  "title": "Decision",
  "description": "One decision as a named person made it: who, when, which items, approve, reject, or hold, why, and the plan fingerprint it was made on. A second person's confirmation is the approval's second signature.",
  "type": "object",
  "required": ["by", "at", "items", "decision", "fingerprint"],
  "additionalProperties": false,
  "properties": {
    "by": {"type": "string", "minLength": 1},
    "at": {"type": "string", "description": "UTC, ISO 8601, seconds."},
    "items": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[0-9a-f]{16}$"}},
    "decision": {"enum": ["approved", "rejected", "held"]},
    "reason": {"type": "string"},
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "via": {"enum": ["cli", "console"]}
  },
  "if": {"properties": {"decision": {"enum": ["rejected", "held"]}}},
  "then": {"required": ["reason"], "properties": {"reason": {"minLength": 1}}},
  "$defs": {
    "signature": {
      "title": "Signature",
      "description": "A person's signature on a plan fingerprint: the first submits the decisions; the second, a distinct person, confirms the same fingerprint.",
      "type": "object",
      "required": ["name", "at", "fingerprint"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "at": {"type": "string"},
        "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "role": {"type": "string"},
        "via": {"enum": ["cli", "console"]}
      }
    }
  }
}
