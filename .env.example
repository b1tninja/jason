# This file is a project's .env: the checkout's own settings. The machine's settings (where scratch, caches, and data
# live) go once in the user config, ~/.jason/.env (JASON_CONFIG names another file), which is read from any working
# directory; this file overrides it, and the process environment wins over both (docs/setup.md, Where jason writes).
# The same for asspy (~/.asspy/.env: ASSPY_HOME) and lawlibrary (~/.lawlibrary/.env: LAWLIBRARY_DATA).
# The association profile (docs/profiles.md); mystique when unset. JASON_PROFILE_DIR points at a profile package elsewhere.
# JASON_PROFILE = "mystique"
# The data root (docs/profiles.md#each-profiles-data); data/ beside the checkout when unset. Another profile's stores
# are in <root>/<profile>/, and every profile's private facts in <root>/spec/.
# JASON_DATA_DIR = "D:/somewhere/data"
# Where asspy keeps its county index caches, association directories, and downloads; %LOCALAPPDATA%\asspy when unset
# (the process environment's ASSPY_HOME wins). Name a folder on the data drive.
# ASSPY_HOME = "D:/somewhere/asspy"
keeper_username = "you@example.com"
# keeper_password only needed if you skip `jason login` password persistence:
# keeper_password = "..."
payhoa_record_uid = "YOUR_PAYHOA_RECORD_UID"
# an unprivileged owner account for testing forms from an owner's side (optional)
payhoa_test_record_uid = ""
# PayHOA memberships kept for testing (comma-separated): their answers are never an owner's, and a real send skips them
payhoa_test_membership_ids = ""
# your own PayHOA membership and unit, for a test sent to yourself
payhoa_my_membership_id = ""
payhoa_my_unit_id = ""
smud_record_uid = "YOUR_SMUD_RECORD_UID"
idoxs_record_uid = "YOUR_IDOXS_RECORD_UID"
# Sacramento Citizen Access (aca-prod.accela.com). Public search works without it.
accela_record_uid = ""
# Vendor customer portals (mystique/vendors.py): one "<key>_record_uid" per portal, a Keeper login record.
proactive_record_uid = ""
signalservice_record_uid = ""
# payhoa_org_id = "YOUR_PAYHOA_ORG_ID"  (the number in app.payhoa.com/organizations/<id>/...)
# keeper_config defaults to %USERPROFILE%\.keeper\keeper-config.json
# smud_db = "../smud/data/smud.db"
# smud_bills_dir = "../smud/data/bills"
# idoxs_db = "../i-doxs/data/idoxs.db"
# idoxs_bills_dir = "../i-doxs/data/bills"

# Google Sheets OAuth client lives in Keeper, not in this file.
# Record custom fields: client_id, client_secret (hidden). See README.
# Enable Sheets and Drive on that same Cloud project. Drive scope:
# https://www.googleapis.com/auth/drive.readonly
google_oauth_record_uid = ""
# Console sign-in (jason-web): each community's own clients live in data/spec/<profile>/sign_in.json and jason's in
# data/access/sign_in.json (`jason sign-in --import-client FILE --yes` writes them). With neither, this record, else the
# client above. See docs/setup.md "Console sign-in".
# google_signin_record_uid = ""
# Consumer NotebookLM notebook. Not an API id.
google_notebook_url = "https://notebook.google.com/notebook/YOUR_NOTEBOOK_ID"
# Written by the first browser login.
# google_oauth_token_file = "secrets/google-token.json"
google_sheets_spreadsheet_id = ""

# Scratch for temp files, OCR page images, SQLite's sorts during an index build, and pytest's tmp_path: a folder on a
# roomy drive. Unset leaves the system's temp folder alone. A drive that is missing stops jason, never falls back to C:.
# `jason storage --check` says whether it is needed (docs/setup.md, Where jason writes). Write the path without quotes, or
# with forward slashes: in double quotes .env reads \t in D:\scratch\jason\tmp as a tab.
# JASON_TEMP_DIR=D:\scratch\jason\tmp

# The lawlibrary checkout (its own .venv is used); statute text for `jason export-authorities`.
lawlibrary_home = "../lawlibrary"
# PostScanMail virtual mailbox: a Keeper login record whose password field holds the API key.
postscanmail_record_uid = ""
# Zoom Server-to-Server OAuth app: a Keeper record with custom fields account_id, client_id; the client secret in its password field (`jason zoom --store-app`; docs/zoom.md).
zoom_record_uid = ""
